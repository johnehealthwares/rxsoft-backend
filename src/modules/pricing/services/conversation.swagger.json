  "components": {
    "schemas": {
      "CreateOptionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Existing Option ID to attach"
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "index": {
            "type": "number"
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "index"
        ]
      },
      "CreateQuestionDto": {
        "type": "object",
        "properties": {
          "questionnaireId": {
            "type": "string"
          },
          "attribute": {
            "type": "string",
            "description": "Machine-friendly attribute key used when responses are aggregated"
          },
          "text": {
